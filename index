<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Sr. Lobo Burgerz — Pedidos & Facturas</title>
<style>
:root { --bg: #080808; --card: #171717; --card2: #242424; --purple: #b51f2a; --green: #d4af37; --gold: #d4af37; --text: #ffffff; --muted: #c8c8c8; --red: #e32636; }
* { box-sizing: border-box; }
body { margin: 0; font-family: Trebuchet MS, Arial, sans-serif; background: linear-gradient(160deg, #050505, #180707); color: var(--text); }
header { padding: 24px 18px 12px; text-align: center; }
h1 { margin: 0; font-size: 28px; letter-spacing: 2px; color: #fff; }
header p { color: var(--muted); margin: 8px 0; }
main { max-width: 900px; margin: auto; padding: 14px; }
nav { display: flex; gap: 8px; overflow: auto; margin-bottom: 14px; }
nav button { white-space: nowrap; }
button { border: 0; border-radius: 14px; padding: 13px 16px; font-weight: 700; cursor: pointer; background: var(--card2); color: var(--text); }
button.primary { background: var(--red); color: #ffffff; }
button.purple { background: #8f1821; color: white; }
.tab { display: none; }
.tab.active { display: block; }
.card { background: #242424; border: 1px solid #4a4a4a; border-radius: 20px; padding: 18px; margin-bottom: 14px; box-shadow: 0 12px 30px #0008; }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px; }
.field { display: flex; flex-direction: column; gap: 6px; }
.field label { font-size: 13px; color: var(--muted); }
input, select { width: 100%; padding: 13px; border-radius: 12px; border: 1px solid #555; background: #101010; color: white; font-size: 16px; outline: none; }
input:focus, select:focus { border-color: var(--gold); }
.actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
.small { padding: 9px 11px; font-size: 13px; }
.stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
.stat { background: #0d0d0d; border-radius: 15px; padding: 15px; }
.stat small { color: var(--muted); }
.stat b { display: block; font-size: 21px; margin-top: 5px; }
table { width: 100%; border-collapse: collapse; }
th, td { text-align: left; padding: 10px; border-bottom: 1px solid #3a3a3a; }
th { color: var(--muted); font-size: 13px; }
.status { padding: 6px 10px; border-radius: 99px; font-size: 12px; font-weight: 800; display: inline-block; }
.paid { background: #173016; color: #e6d27a; }
.pending { background: #3b2410; color: #f2c96b; }
.abonado { background: #4a3d0e; color: #f5dc74; }
.modal { position: fixed; inset: 0; background: #000b; display: none; align-items: center; justify-content: center; padding: 16px; z-index: 10; }
.modal.show { display: flex; }
.invoice { background: #181818; color: #fff; border: 2px solid #b3131b; border-radius: 24px; max-width: 480px; width: 100%; max-height: 92vh; overflow: auto; padding: 22px; }
.invoice h2 { color: var(--gold); letter-spacing: 2px; }
.qr { background: white; padding: 12px; border-radius: 14px; width: max-content; margin: 18px auto; }
.invoice .line { display: flex; justify-content: space-between; gap: 15px; padding: 8px 0; border-bottom: 1px solid #3a3a3a; }
.note { font-size: 12px; color: var(--muted); text-align: center; line-height: 1.5; }
.search { margin-bottom: 12px; }
.invoice-brand { text-align: center; border-bottom: 1px solid #444; padding-bottom: 12px; margin-bottom: 12px; }
.invoice-brand .name { font-size: 24px; font-weight: 900; letter-spacing: 1px; }
.invoice-brand .sub { font-size: 12px; color: #d4af37; letter-spacing: 2px; }
.cloud-status { text-align: center; font-size: 12px; color: var(--muted); margin-bottom: 10px; }
@media(max-width: 520px){ .stats { grid-template-columns: 1fr 1fr; } .hide-mobile { display: none; } }
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
</head>
<body>

<header>
  <h1>🐺 <span style="color:#e3262e">SR. LOBO</span> BURGERZ</h1>
  <p style="font-weight:800;letter-spacing:1px">PEDIDOS & FACTURAS (vSheets)</p>
</header>

<main>
  <p class="cloud-status" id="cloudStatus">☁️ Conectando con Google Sheets...</p>

  <nav>
    <button onclick="showTab('menu')">🍔 Menú</button>
    <button class="purple" onclick="showTab('nuevo')">➕ Nuevo pedido</button>
    <button onclick="showTab('pedidos')">📋 Pedidos</button>
    <button onclick="showTab('panel')">📊 Resumen</button>
  </nav>

  <!-- SECCIÓN MENÚ -->
  <section id="menu" class="tab active">
    <div class="card">
      <h2>Menú Principal</h2>
      <div class="grid">
        <div class="stat" style="text-align: center;">
          <h3 style="color: var(--gold); margin: 5px 0;">La Lobo Clásica</h3>
          <p style="font-size: 13px; color: var(--muted);">Carne 150g, queso cheddar, tocino.</p>
          <b style="font-size: 18px; display: block; margin-bottom: 10px;">$25.000</b>
          <button class="primary small" onclick="seleccionarDelMenu('La Lobo Clásica', 25000)">Pedir esta</button>
        </div>
        <div class="stat" style="text-align: center;">
          <h3 style="color: var(--gold); margin: 5px 0;">Doble Aullido</h3>
          <p style="font-size: 13px; color: var(--muted);">Doble carne, doble queso.</p>
          <b style="font-size: 18px; display: block; margin-bottom: 10px;">$32.000</b>
          <button class="primary small" onclick="seleccionarDelMenu('Doble Aullido', 32000)">Pedir esta</button>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN NUEVO PEDIDO -->
  <section id="nuevo" class="tab">
    <div class="card">
      <h2>Registrar pedido</h2>
      <div class="grid">
        <div class="field"><label>Cliente *</label><input id="nombre"></div>
        <div class="field"><label>Grado</label><input id="grado"></div>
        <div class="field"><label>Producto *</label><input id="producto"></div>
        <div class="field"><label>Precio total *</label><input id="total" type="number"></div>
        <div class="field"><label>Abono inicial</label><input id="montoApartado" type="number" value="2000"></div>
      </div>
      <div class="actions">
        <button class="primary" onclick="crearPedido()">Guardar y generar factura</button>
      </div>
    </div>
  </section>

  <!-- SECCIÓN PEDIDOS -->
  <section id="pedidos" class="tab">
    <div class="card">
      <h2>Pedidos</h2>
      <input class="search" id="busqueda" placeholder="🔍 Buscar..." oninput="renderPedidos()">
      <div id="tabla"></div>
    </div>
  </section>

  <!-- SECCIÓN PANEL -->
  <section id="panel" class="tab">
    <div class="card">
      <h2>Resumen</h2>
      <div class="stats" id="stats"></div>
    </div>
  </section>
</main>

<!-- MODALES -->
<div class="modal" id="modal">
  <div class="invoice">
    <div style="display:flex;justify-content:space-between;align-items:center">
      <span>FACTURA</span><button onclick="cerrarModal()">✕</button>
    </div>
    <div class="invoice-brand"><div class="name">🐺 SR. LOBO BURGERZ</div></div>
    <h2 id="invCode"></h2>
    <div id="invData"></div>
    <div class="qr" id="qrcode"></div>
    <div class="actions">
      <button class="primary" onclick="abrirAbono(window.current)">💵 Registrar abono</button>
      <button onclick="cerrarModal()">Listo</button>
    </div>
  </div>
</div>

<div class="modal" id="abonoModal">
  <div class="invoice">
    <div style="display:flex;justify-content:space-between;align-items:center">
      <span>REGISTRAR ABONO</span><button onclick="cerrarAbono()">✕</button>
    </div>
    <h2 id="abonoCode"></h2>
    <p id="abonoResumen" class="note"></p>
    <div class="field"><label>Valor</label><input id="nuevoAbono" type="number"></div>
    <div class="actions">
      <button class="primary" onclick="guardarAbono()">Guardar abono</button>
      <button onclick="cerrarAbono()">Cancelar</button>
    </div>
  </div>
</div>

<script>
let pedidos = [];
const money = n => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(n || 0);

// Cargar datos al iniciar usando Google Scripts
window.onload = function() {
  google.script.run.withSuccessHandler(actualizarPantalla).obtenerPedidos();
};

function actualizarPantalla(data) {
  pedidos = data || [];
  document.getElementById('cloudStatus').textContent = '☁️ Conectado — ' + pedidos.length + ' pedidos en Sheets';
  renderPedidos();
  renderStats();
}

function showTab(id) {
  document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  if(id === 'pedidos') renderPedidos();
  if(id === 'panel') renderStats();
}

function seleccionarDelMenu(prod, prec) {
  showTab('nuevo');
  document.getElementById('producto').value = prod;
  document.getElementById('total').value = prec;
  document.getElementById('nombre').focus();
}

const nextCode = () => {
  let max = 1013;
  pedidos.forEach(p => { let n = parseInt((p.codigo || '').replace('DOC-', '')); if(n > max) max = n; });
  return 'DOC-' + (max + 1);
};

function crearPedido() {
  const p = {
    codigo: nextCode(),
    nombre: document.getElementById('nombre').value.trim(),
    grado: document.getElementById('grado').value.trim(),
    producto: document.getElementById('producto').value.trim(),
    total: Number(document.getElementById('total').value),
    abonos: [{ monto: Number(document.getElementById('montoApartado').value || 0), fecha: new Date().toLocaleString('es-CO') }],
    fecha: new Date().toLocaleString('es-CO')
  };

  if(!p.nombre || !p.producto || !p.total) return alert('Faltan datos.');

  document.getElementById('cloudStatus').textContent = '⏳ Guardando en Sheets...';
  
  // Enviar a Google Apps Script
  google.script.run.withSuccessHandler(function(data) {
    actualizarPantalla(data);
    abrirFactura(p);
    document.getElementById('nombre').value = '';
    document.getElementById('grado').value = '';
    document.getElementById('producto').value = '';
    document.getElementById('total').value = '';
  }).guardarPedido(p);
}

const abonado = p => (p.abonos || []).reduce((s, a) => s + Number(a.monto), 0);
const estado = p => abonado(p) >= p.total ? 'PAGADO' : (abonado(p) > 0 ? 'ABONADO' : 'PENDIENTE');
const estadoClass = e => e === 'PAGADO' ? 'paid' : (e === 'ABONADO' ? 'abonado' : 'pending');

function abrirFactura(p) {
  document.getElementById('modal').classList.add('show');
  document.getElementById('invCode').textContent = 'FACTURA N.º ' + p.codigo;
  const a = abonado(p);
  const saldo = Math.max(0, p.total - a);

  document.getElementById('invData').innerHTML = `
    <div class="line"><span>Cliente</span><b>${p.nombre}</b></div>
    <div class="line"><span>Producto</span><b>${p.producto}</b></div>
    <div class="line"><span>Total</span><b>${money(p.total)}</b></div>
    <div class="line"><span>Abonado</span><b>${money(a)}</b></div>
    <div class="line"><span>Saldo</span><b>${money(saldo)}</b></div>
    <div class="line"><span>Estado</span><b class="status ${estadoClass(estado(p))}">${estado(p)}</b></div>
  `;

  document.getElementById('qrcode').innerHTML = '';
  new QRCode(document.getElementById('qrcode'), { text: p.codigo, width: 210, height: 210 });
  window.current = p.codigo;
}

function cerrarModal() { document.getElementById('modal').classList.remove('show'); cerrarAbono(); }

function renderPedidos() {
  const q = (document.getElementById('busqueda')?.value || '').toLowerCase();
  const arr = pedidos.filter(p => (p.nombre + ' ' + p.codigo).toLowerCase().includes(q)).slice().reverse();
  
  if(!arr.length) { document.getElementById('tabla').innerHTML = '<p class="note">No hay pedidos.</p>'; return; }
  
  document.getElementById('tabla').innerHTML = `<table>
    <thead><tr><th>Código</th><th>Cliente</th><th>Estado</th><th>Saldo</th><th></th></tr></thead>
    <tbody>
      ${arr.map(p => `<tr>
        <td>${p.codigo}</td><td>${p.nombre}</td>
        <td><span class="status ${estadoClass(estado(p))}">${estado(p)}</span></td>
        <td>${money(Math.max(0, p.total - abonado(p)))}</td>
        <td>
          <button class="small" onclick="abrirFactura(pedidos.find(x=>x.codigo==='${p.codigo}'))">Ver</button>
          ${estado(p) !== 'PAGADO' ? `<button class="small primary" onclick="window.current='${p.codigo}'; abrirAbono('${p.codigo}')">Abonar</button>` : ''}
        </td>
      </tr>`).join('')}
    </tbody></table>`;
}

function renderStats() {
  const total = pedidos.reduce((s, p) => s + p.total, 0);
  const rec = pedidos.reduce((s, p) => s + abonado(p), 0);
  document.getElementById('stats').innerHTML = `
    <div class="stat"><small>Pedidos</small><b>${pedidos.length}</b></div>
    <div class="stat"><small>En Caja</small><b>${money(rec)}</b></div>
    <div class="stat"><small>Por cobrar</small><b>${money(total - rec)}</b></div>
  `;
}

function abrirAbono(codigo) {
  const p = pedidos.find(x => x.codigo === codigo);
  if(!p) return;
  document.getElementById('abonoCode').textContent = 'PEDIDO ' + p.codigo;
  document.getElementById('nuevoAbono').max = Math.max(0, p.total - abonado(p));
  window.current = p.codigo;
  document.getElementById('abonoModal').classList.add('show');
}

function cerrarAbono() { document.getElementById('abonoModal').classList.remove('show'); }

function guardarAbono() {
  const codigo = window.current;
  const valor = Number(document.getElementById('nuevoAbono').value || 0);
  if(valor <= 0) return alert('Ingresa un valor.');

  document.getElementById('cloudStatus').textContent = '⏳ Guardando abono en Sheets...';
  
  // Enviar a Google Apps Script
  google.script.run.withSuccessHandler(function(data) {
    actualizarPantalla(data);
    alert('Abono guardado.');
    cerrarAbono();
    cerrarModal();
  }).guardarAbonoBackend(codigo, { monto: valor, fecha: new Date().toLocaleString('es-CO') });
}
</script>
</body>
</html>
